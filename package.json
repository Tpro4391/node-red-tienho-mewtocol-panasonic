{
  "name": "@tpro4391/node-red-tienho-mewtocol-panasonic",
  "version": "1.2.0",
  "description": "Panasonic PLC MEWTOCOL-COM over TCP for Node-RED: shared queued connection, read/write nodes and Data Logger Light (DLL) telemetry",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/protocol.test.js test/client.test.js test/nodes.test.js test/dll.test.js"
  },
  "author": "Tpro4391",
  "contributors": [
    "Oleg Aroslanov (original node-red-contrib-mewtocol)"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "automation",
    "data logger light",
    "dll",
    "fp-x",
    "fp0h",
    "fp7",
    "industrial",
    "mewtocol",
    "node-red",
    "panasonic",
    "plc",
    "thingsboard"
  ],
  "engines": {
    "node": ">=14"
  },
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "Mewtocol-Client": "mewtocol/mewtocol-client.js",
      "Mewtocol-RD": "mewtocol/mewtocol-rd.js",
      "Mewtocol-RCC": "mewtocol/mewtocol-rcc.js",
      "Mewtocol-RCS": "mewtocol/mewtocol-rcs.js",
      "Mewtocol-RCP": "mewtocol/mewtocol-rcp.js",
      "Mewtocol-RT": "mewtocol/mewtocol-rt.js",
      "Mewtocol-RR": "mewtocol/mewtocol-rr.js",
      "Mewtocol-RS": "mewtocol/mewtocol-rs.js",
      "Mewtocol-RK": "mewtocol/mewtocol-rk.js",
      "Mewtocol-WD": "mewtocol/mewtocol-wd.js",
      "Mewtocol-WCC": "mewtocol/mewtocol-wcc.js",
      "Mewtocol-WCS": "mewtocol/mewtocol-wcs.js",
      "Mewtocol-WS": "mewtocol/mewtocol-ws.js",
      "Mewtocol-WK": "mewtocol/mewtocol-wk.js",
      "Mewtocol-RAW": "mewtocol/mewtocol-raw.js",
      "Mewtocol-DLL": "mewtocol/mewtocol-dll.js"
    }
  },
  "files": [
    "lib/**/*",
    "mewtocol/**/*",
    "examples/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "node-red": "^4.0.0",
    "node-red-node-test-helper": "^0.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tpro4391/node-red-tienho-mewtocol-panasonic.git"
  },
  "bugs": {
    "url": "https://github.com/Tpro4391/node-red-tienho-mewtocol-panasonic/issues"
  },
  "homepage": "https://github.com/Tpro4391/node-red-tienho-mewtocol-panasonic#readme",
  "publishConfig": {
    "access": "public"
  }
}
